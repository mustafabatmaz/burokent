# Runs the nightly backup; started by burokent-backup.timer. Installed with:
#   sudo cp infra/backup/burokent-backup.service infra/backup/burokent-backup.timer /etc/systemd/system/
# The paths below assume the repository at /home/mustafa/burokent.
[Unit]
Description=Back up the BüroKent database to Backblaze B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=mustafa
Environment=HOME=/home/mustafa
ExecStart=/home/mustafa/burokent/infra/backup/backup.sh
