# Copy to infra/.env and replace every placeholder. Never commit infra/.env.

# PostgreSQL superuser, only used to initialise the database
POSTGRES_DB=burokent
POSTGRES_PASSWORD=change-me

# Schema owner (Liquibase) and restricted application user
DB_OWNER_USER=burokent_owner
DB_OWNER_PASSWORD=change-me
DB_APP_USER=burokent_app
DB_APP_PASSWORD=change-me

# Backend connection (dev: host port 5433; prod: postgres:5432 inside the compose network)
DB_URL=jdbc:postgresql://localhost:5433/burokent

# Image files (development; in production the compose file puts them on a volume)
MEDIA_ROOT=../.local/media

# Optional: key of the central bank's EVDS data service (free account at evds3.tcmb.gov.tr), for the gold price
# on the admin panel's start page. Without it the gold card says it is not set up.
EVDS_API_KEY=

# Signing key for access tokens: at least 256 bits, base64. Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# First super admin, created once by a migration. The username must be lowercase.
# Generate the hash locally (it asks for the password):
#   docker run --rm -it httpd:2.4-alpine htpasswd -nBC 12 admin
# Take the part after "admin:", prefix it with {bcrypt} and keep the single quotes.
# Both values can be removed after the first start.
BOOTSTRAP_ADMIN_USERNAME=change-me
BOOTSTRAP_ADMIN_PASSWORD_HASH='{bcrypt}$2y$12$change-me'

# Production only: the public site address, written into its pages at build time (canonical and hreflang links)
SITE_URL=https://burokent.com
