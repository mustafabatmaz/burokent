# Copy to infra/.env and replace every placeholder. Never commit infra/.env.

# PostgreSQL superuser, only used to initialise the database
POSTGRES_DB=burokent
POSTGRES_PASSWORD=change-me

# Schema owner (Liquibase) and restricted application user
DB_OWNER_USER=burokent_owner
DB_OWNER_PASSWORD=change-me
DB_APP_USER=burokent_app
DB_APP_PASSWORD=change-me

# Backend connection (dev: host port 5433; prod: postgres:5432 inside the compose network)
DB_URL=jdbc:postgresql://localhost:5433/burokent
