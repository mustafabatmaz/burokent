# The end-to-end tests' edge Caddy: the server's edge setup in miniature, with locally signed certificates
{
	local_certs
}

(common) {
	header {
		Strict-Transport-Security "max-age=0"
		-Server
	}
}

# The server loads its origin certificate here; locally the signed certificates above are used
(burokent_tls) {
}

import /etc/caddy/sites/*.caddy
